PRIVATE_KEY=0xyour_deployer_private_key
BASESCAN_API_KEY=your_basescan_v2_key
BASE_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org

NFT_NAME=Hat Pets
NFT_SYMBOL=HATPET

# Claim site URL prefix. Each hat gets {CLAIM_BASE_URL}/{token}.
CLAIM_BASE_URL=https://your-claim-site.app/c

