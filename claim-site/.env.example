# =============================================
# Hat Pets claim site: environment configuration
# Copy this file to .env.local and fill in values.
# =============================================

# Privy App ID. Create a free app at https://privy.io,
# then paste the App ID here. Required.
NEXT_PUBLIC_PRIVY_APP_ID=

# Address of the HatPet UUPS proxy on the target chain.
# This is the address you call claim() on. Required.
NEXT_PUBLIC_PROXY_ADDRESS=0x0000000000000000000000000000000000000000

# Target chain id. 8453 = Base mainnet (default). 84532 = Base Sepolia.
NEXT_PUBLIC_CHAIN_ID=8453

# Private RPC used for tx submission (defeats public mempool front-running).
# Default: Flashbots Protect for Base.
# Override with your own private relay if you have one.
NEXT_PUBLIC_PRIVATE_RPC_URL=https://protect.flashbots.net/rpc

# Public RPC used for read-only calls (state, tokenURI, etc.).
# Default: Base public RPC. Replace with a paid endpoint (Alchemy,
# QuickNode, Ankr) for production reliability.
NEXT_PUBLIC_PUBLIC_RPC_URL=https://mainnet.base.org
